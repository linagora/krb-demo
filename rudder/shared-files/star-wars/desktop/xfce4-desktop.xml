<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by Rudder (star-wars-desktop-files): the workstations' wallpaper.
     Every property is locked for all users (locked="*"): xfconf refuses a
     change, in the settings dialogs as in xfconf-query. The monitor's name
     depends on the machine, hence one block per usual name. -->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0" locked="*"/>
          <property name="image-style" type="int" value="5" locked="*"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/star-wars-wallpaper.png" locked="*"/>
        </property>
      </property>
      <property name="monitorVirtual-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0" locked="*"/>
          <property name="image-style" type="int" value="5" locked="*"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/star-wars-wallpaper.png" locked="*"/>
        </property>
      </property>
      <property name="monitorVGA-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0" locked="*"/>
          <property name="image-style" type="int" value="5" locked="*"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/star-wars-wallpaper.png" locked="*"/>
        </property>
      </property>
      <property name="monitorVGA1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0" locked="*"/>
          <property name="image-style" type="int" value="5" locked="*"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/star-wars-wallpaper.png" locked="*"/>
        </property>
      </property>
      <property name="monitorVirtual1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0" locked="*"/>
          <property name="image-style" type="int" value="5" locked="*"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/star-wars-wallpaper.png" locked="*"/>
        </property>
      </property>
      <property name="monitorHDMI-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0" locked="*"/>
          <property name="image-style" type="int" value="5" locked="*"/>
          <property name="last-image" type="string" value="/usr/share/backgrounds/star-wars-wallpaper.png" locked="*"/>
        </property>
      </property>
    </property>
  </property>
</channel>
