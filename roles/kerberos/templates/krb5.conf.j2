# Generated by Ansible.
[libdefaults]
    default_realm = {{ sw_realm }}
    dns_lookup_realm = false
    dns_lookup_kdc = false
    rdns = false
    ticket_lifetime = 10h
    renew_lifetime = 7d
    forwardable = true

[realms]
    {{ sw_realm }} = {
        kdc = {{ sw_fqdn }}
        admin_server = {{ sw_fqdn }}
    }

[domain_realm]
    .{{ sw_domain }} = {{ sw_realm }}
    {{ sw_domain }} = {{ sw_realm }}
