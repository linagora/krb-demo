#!/usr/bin/python3
# Generated by Ansible.
"""Give a Unix identity to every Twake account that lacks one.

The console creates accounts with no POSIX attributes; workstations need
them. Each account without posixAccount gets the next free uidNumber, the
demo's primary group, a home directory and a shell. Accounts are taken in
creation order, so that ids follow the order accounts were made in.
"""
import fcntl
import sys

import ldap

BASE = "{{ sw_ldap_base }}"
USERS = "ou=users,{{ sw_ldap_base }}"
UID_MIN = {{ sw_uid_min }}
GID = "{{ sw_unix_gid }}"


def first(entry, name):
    values = entry.get(name)
    return values[0].decode() if values else None


# One run at a time: the timer and Ansible could hand out the same id.
lock = open("/run/lock/sw-posix-accounts", "w")
fcntl.flock(lock, fcntl.LOCK_EX)

conn = ldap.initialize("ldapi:///")
conn.sasl_non_interactive_bind_s("EXTERNAL")

# Ids held anywhere, the trash included, are never handed out again.
used = {
    int(first(attrs, "uidNumber"))
    for _, attrs in conn.search_s(BASE, ldap.SCOPE_SUBTREE, "(uidNumber=*)", ["uidNumber"])
}
next_uid = max(used | {UID_MIN - 1}) + 1

pending = conn.search_s(
    USERS,
    ldap.SCOPE_SUBTREE,
    "(&(objectClass=twakeAccount)(!(objectClass=posixAccount)))",
    ["uid", "cn", "displayName", "givenName", "sn", "createTimestamp"],
)
pending.sort(key=lambda e: first(e[1], "createTimestamp") or "")

for dn, attrs in pending:
    uid = first(attrs, "uid")
    mods = [
        (ldap.MOD_ADD, "objectClass", [b"posixAccount"]),
        (ldap.MOD_ADD, "uidNumber", [str(next_uid).encode()]),
        (ldap.MOD_ADD, "gidNumber", [GID.encode()]),
        (ldap.MOD_ADD, "homeDirectory", [f"/home/{uid}".encode()]),
        (ldap.MOD_ADD, "loginShell", [b"/bin/bash"]),
    ]
    # posixAccount needs a cn, which the console does not ask for.
    if not attrs.get("cn"):
        name = first(attrs, "displayName") or " ".join(
            filter(None, (first(attrs, "givenName"), first(attrs, "sn")))
        )
        mods.append((ldap.MOD_ADD, "cn", [(name or uid).encode()]))
    try:
        conn.modify_s(dn, mods)
    except ldap.LDAPError as err:
        print(f"{uid}: {err}", file=sys.stderr)
        continue
    print(f"{uid}: uidNumber {next_uid}")
    next_uid += 1
