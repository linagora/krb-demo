<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by Ansible. -->
{# The salt is drawn from the password: the same password gives the same hash, so that a second run changes nothing. Its last character is one of those bcrypt keeps whole (.Oeu). #}
<authentication unsafe-hashes="false" hash="bcrypt" case-sensitivity="true">
  <user name="{{ sw_rudder_admin }}" password="{{ sw_rudder_admin_hash }}" role="administrator"/>
</authentication>
