# Generated by Ansible: indexes, limits and ACLs of {{ sw_ldap_base }}.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcDbIndex
olcDbIndex: objectClass eq
olcDbIndex: uid,cn,sn,givenName,displayName,mail eq,sub
olcDbIndex: employeeNumber,associatedDomain eq
olcDbIndex: uidNumber,gidNumber,memberUid eq
olcDbIndex: member,owner,memberOf eq
olcDbIndex: twakeDepartmentLink,twakeLocalAdminLink,twakeManagerLink,twakeAccountStatus eq
olcDbIndex: twakeDepartmentPath eq,sub
olcDbIndex: entryUUID,entryCSN eq
-
replace: olcLimits
olcLimits: dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth size=unlimited time=unlimited
olcLimits: dn.exact="{{ sw_ldap_tdm_dn }}" size=unlimited time=unlimited
olcLimits: dn.exact="{{ sw_ldap_llng_dn }}" size=unlimited time=unlimited
olcLimits: dn.exact="{{ sw_ldap_workstation_dn }}" size=unlimited time=unlimited
-
replace: olcAccess
olcAccess: to *
  by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage
  by dn.exact="{{ sw_ldap_tdm_dn }}" manage
  by * break
olcAccess: to attrs=userPassword
  by self write
  by anonymous auth
  by * none
olcAccess: to dn.subtree="ou=applicative,{{ sw_ldap_base }}"
  by self read
  by * none
olcAccess: to *
  by dn.exact="{{ sw_ldap_llng_dn }}" read
  by users read
  by * none
