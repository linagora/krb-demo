# Mail attributes twakeAccount refers to, from ldap-rest
# (test/fixtures/mail-schema.ldif). mailForwardingAddress usually comes from
# an inetmaildomain schema Debian does not ship, so it is defined here too.
#
# misc.ldif must stay unloaded: it defines mailHost as well.

dn: cn=mail,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: mail
olcAttributeTypes: {0}( 1.3.6.1.4.1.99999.2.1.1 NAME 'mailAlternateAddress' DESC 'Alternate email address' EQUALITY caseIgnoreIA5Match SUBSTR caseIgnoreIA5SubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )
olcAttributeTypes: {1}( 1.3.6.1.4.1.99999.2.1.2 NAME 'mailHost' DESC 'Mail server host' EQUALITY caseIgnoreIA5Match SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 SINGLE-VALUE )
olcAttributeTypes: {2}( 1.3.6.1.4.1.99999.2.1.3 NAME 'mailQuotaSize' DESC 'Mail quota size in bytes' EQUALITY integerMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )
olcAttributeTypes: {3}( 1.3.6.1.4.1.99999.2.1.4 NAME 'mailForwardingAddress' DESC 'Address mail is forwarded to' EQUALITY caseIgnoreIA5Match SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{256} )
olcAttributeTypes: {4}( 1.3.6.1.4.1.99999.2.1.5 NAME 'mailReplyText' DESC 'Mail auto-reply text' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
