# Generated by Ansible.
[sssd]
services = nss, pam
domains = {{ sw_domain }}

[domain/{{ sw_domain }}]
# Who users are: the directory. Accounts get their Unix attributes from the
# posix role on the domain controller.
id_provider = ldap
ldap_uri = ldap://{{ sw_fqdn }}
ldap_schema = rfc2307
ldap_search_base = {{ sw_ldap_base }}
ldap_user_search_base = ou=users,{{ sw_ldap_base }}
ldap_group_search_base = ou=unix,{{ sw_ldap_base }}
ldap_default_bind_dn = {{ sw_ldap_workstation_dn }}
ldap_default_authtok = {{ sw_ldap_workstation_password }}
# The bind password travels over StartTLS, checked against the demo CA.
ldap_id_use_start_tls = true
ldap_tls_reqcert = demand
ldap_tls_cacert = /etc/ssl/certs/ca-certificates.crt

# Their password: the KDC, which hands out a ticket at login. The machine's
# keytab lets sssd check that the ticket comes from the real KDC.
auth_provider = krb5
krb5_server = {{ sw_fqdn }}
krb5_realm = {{ sw_realm }}
krb5_validate = true
# Passwords change on the SSO portal, never on the machine.
chpass_provider = none

# Who may log in: active accounts, as for the SSO.
access_provider = ldap
ldap_access_order = filter
ldap_access_filter = (twakeAccountStatus=cn=active,ou=twakeAccountStatus,ou=nomenclature,{{ sw_ldap_base }})

# Lets users log in while the domain controller is unreachable.
cache_credentials = true
sudo_provider = none
