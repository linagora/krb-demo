#!/bin/bash
# Generated by Ansible.
#
# star-wars-join [host]: joins this machine to the {{ sw_realm }} domain.
#
# Create the computer in the directory console first, and reset its password
# there: the console shows a one-time password, asked for here (or read from
# STAR_WARS_JOIN_PASSWORD). The domain controller checks it, and answers with
# the machine's keytab, installed as /etc/krb5.keytab. The password then no
# longer works.
set -euo pipefail

DOMAIN={{ sw_domain }}
JOIN_URL=https://{{ sw_fqdn }}/join

host=${1:-$(hostname -s)}
[ "$(id -u)" = 0 ] || { echo "star-wars-join: run it as root" >&2; exit 1; }
if [ "$(hostname -s)" != "$host" ]; then
  echo "star-wars-join: this machine is $(hostname -s), not $host" >&2
  exit 1
fi

password=${STAR_WARS_JOIN_PASSWORD:-}
if [ -z "$password" ]; then
  read -rsp "One-time password of $host: " password
  echo
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
# The password goes through stdin, never on a command line.
status=$(printf '%s' "$password" | curl -sS -o "$tmp" -w '%{http_code}' \
  --data-urlencode "host=$host" --data-urlencode "password@-" "$JOIN_URL")
if [ "$status" != 200 ]; then
  echo "star-wars-join: refused ($status): $(cat "$tmp")" >&2
  exit 1
fi

install -m 600 "$tmp" /etc/krb5.keytab
kinit -k -c MEMORY:join "host/$host.$DOMAIN" \
  || { echo "star-wars-join: the keytab does not work" >&2; exit 1; }
systemctl try-restart sssd
echo "$host.$DOMAIN joined the domain"
