#!/usr/bin/python3
# Generated by Ansible.
"""Keep the KDC in step with the computers of the directory.

For each computer under ou=computers, the principal host/<cn>.<domain>:
- exists while the computer does (created with a random key);
- may get tickets only while the computer is active: a disabled computer's
  principal gets -allow_tix, and sssd on that machine, which checks every
  login with the machine's key, refuses them all.

Only principals carrying the "{{ sw_computer_krb_policy }}" policy, the mark
of the principals this script and the join service create, are ever
enabled, disabled or deleted. A computer named after an unmarked principal
(a host joined by other means) is left alone, and reported.

Computers also get the computer password policy: their one-time join
password is not a user password (no change forced after a reset), and a
few failures lock it.
"""
import fcntl
import re
import subprocess
import sys

import ldap

BASE = "{{ sw_ldap_base }}"
COMPUTERS = "ou=computers,{{ sw_ldap_base }}"
DOMAIN = "{{ sw_domain }}"
REALM = "{{ sw_realm }}"
ACTIVE = "cn=active,ou=twakeAccountStatus,ou=nomenclature,{{ sw_ldap_base }}".lower()
POLICY = "{{ sw_computer_krb_policy }}"
PWD_POLICY = "cn=computer,ou=policies,{{ sw_ldap_base }}"
HOST_NAME = re.compile(r"\A[a-z0-9][a-z0-9-]{0,62}\Z")


def kadmin(query):
    out = subprocess.run(
        ["kadmin.local", "-q", query],
        capture_output=True, text=True, check=True, timeout=60,
    )
    return out.stdout


def principal(name):
    """Attributes and policy of a principal, or None if it does not exist."""
    out = kadmin(f"getprinc {name}")
    if "Principal: " not in out:
        return None
    attributes = re.search(r"^Attributes:(.*)$", out, re.M)
    policy = re.search(r"^Policy: (\S+)", out, re.M)
    return {
        "attributes": attributes.group(1).split() if attributes else [],
        "policy": policy.group(1) if policy else "",
    }


def first(attrs, name):
    values = attrs.get(name)
    return values[0].decode() if values else None


def log(message):
    print(message, flush=True)


lock = open("/run/lock/sw-computers", "w")
fcntl.flock(lock, fcntl.LOCK_EX)

conn = ldap.initialize("ldapi:///")
conn.sasl_non_interactive_bind_s("EXTERNAL")

# No ou=computers is not "no computers": a database restored half-way would
# otherwise have every marked principal deleted.
computers = conn.search_s(
    COMPUTERS,
    ldap.SCOPE_ONELEVEL,
    "(objectClass=demoWorkstation)",
    ["twakeAccountStatus", "pwdPolicySubentry"],
)

wanted = {}
for dn, attrs in computers:
    # The RDN, as the join service binds with: cn may hold old names too.
    rdn_attr, cn, _ = ldap.dn.str2dn(dn)[0][0]
    cn = cn.lower()
    if rdn_attr.lower() != "cn" or not HOST_NAME.match(cn):
        print(f"{dn}: not a valid host name, ignored", file=sys.stderr)
        continue
    wanted[f"host/{cn}.{DOMAIN}@{REALM}"] = (
        dn,
        (first(attrs, "twakeAccountStatus") or "").lower() == ACTIVE,
    )
    if not attrs.get("pwdPolicySubentry"):
        conn.modify_s(dn, [(ldap.MOD_ADD, "pwdPolicySubentry", [PWD_POLICY.encode()])])

failed = False
for name, (dn, active) in wanted.items():
    # One computer in error must not keep the others from being handled.
    try:
        info = principal(name)
        if info is None:
            kadmin(f"addprinc -randkey -policy {POLICY} {name}")
            log(f"{name}: created")
            info = principal(name)
        if info["policy"] != POLICY:
            print(f"{name}: not created here, left alone", file=sys.stderr)
            continue
        locked = "DISALLOW_ALL_TIX" in info["attributes"]
        if active and locked:
            kadmin(f"modprinc +allow_tix {name}")
            log(f"{name}: enabled")
        elif not active and not locked:
            kadmin(f"modprinc -allow_tix {name}")
            log(f"{name}: disabled")
    except Exception as err:
        print(f"{name}: {err}", file=sys.stderr)
        failed = True

suffix = f".{DOMAIN}@{REALM}"
for name in kadmin("listprincs host/*").split():
    if not (name.startswith("host/") and name.endswith(suffix)) or name in wanted:
        continue
    info = principal(name)
    if info and info["policy"] == POLICY:
        kadmin(f"delprinc -force {name}")
        log(f"{name}: deleted, its computer is gone")

sys.exit(1 if failed else 0)
