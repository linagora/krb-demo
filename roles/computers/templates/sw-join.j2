#!/usr/bin/python3
# Generated by Ansible.
"""Join service: trade a computer's one-time password for its keytab.

POST /join, form fields `host` and `password`:

1. the password is checked by binding to the directory as the computer
   (cn=<host>,ou=computers): the console set it, and showed it once;
2. it is spent at once, replaced by a random one nobody keeps: a password
   reset under the default policy leaves the session able to change the
   password and nothing else, so this comes before reading the entry;
3. the computer must be active;
4. the principal host/<host>.<domain> gets a new random key, exported to a
   keytab, which is the answer.

kadmind is reached as {{ sw_join_principal }}, which may only inquire,
add and change host/* principals. Wrong passwords count against the
computer's password policy, which locks it after a few.
"""
import http.server
import logging
import os
import re
import subprocess
import tempfile
import threading
import urllib.parse

import ldap

LISTEN = ("127.0.0.1", {{ sw_join_port }})
LDAP_URI = "ldap://127.0.0.1"
COMPUTERS = "ou=computers,{{ sw_ldap_base }}"
DOMAIN = "{{ sw_domain }}"
REALM = "{{ sw_realm }}"
ACTIVE = "cn=active,ou=twakeAccountStatus,ou=nomenclature,{{ sw_ldap_base }}".lower()
POLICY = "{{ sw_computer_krb_policy }}"
KADMIN = [
    "kadmin",
    "-k", "-t", "{{ sw_join_keytab }}",
    "-p", "{{ sw_join_principal }}",
    "-s", "{{ sw_fqdn }}",
]
HOST_NAME = re.compile(r"\A[a-z0-9][a-z0-9-]{0,62}\Z")

logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
log = logging.getLogger("sw-join")


class Refused(Exception):
    """A request turned down, with the status and the message to answer."""

    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


# One join at a time: a password raced by two requests must serve once.
JOIN_LOCK = threading.Lock()


def kadmin(query):
    out = subprocess.run(
        KADMIN + ["-q", query], capture_output=True, text=True, timeout=60
    )
    if out.returncode != 0:
        raise RuntimeError(f"kadmin {query.split()[0]}: {out.stderr.strip()}")
    return out.stdout


def join(host, password):
    if not HOST_NAME.match(host) or not password:
        raise Refused(400, "host and password are required")
    dn = f"cn={host},{COMPUTERS}"

    conn = ldap.initialize(LDAP_URI)
    try:
        conn.simple_bind_s(dn, password)
    except (ldap.INVALID_CREDENTIALS, ldap.NO_SUCH_OBJECT):
        # Same answer for an unknown computer and a wrong password.
        raise Refused(403, "unknown computer or wrong password")

    # Spent now, whatever follows: a refusal below needs a new reset anyway.
    _, response = conn.passwd_s(dn, password, None, extract_newpw=True)
    spent = response.genPasswd
    conn.unbind_s()
    conn = ldap.initialize(LDAP_URI)
    conn.simple_bind_s(dn, spent)

    entry = conn.search_s(dn, ldap.SCOPE_BASE, attrlist=["twakeAccountStatus"])
    status = entry[0][1].get("twakeAccountStatus", [b""])[0].decode().lower()
    if status != ACTIVE:
        raise Refused(403, "this computer is disabled")

    name = f"host/{host}.{DOMAIN}@{REALM}"
    info = kadmin(f"getprinc {name}")
    if "Principal: " not in info:
        try:
            kadmin(f"addprinc -randkey -policy {POLICY} {name}")
        except RuntimeError:
            # The reconciler may have created it meanwhile.
            info = kadmin(f"getprinc {name}")
            if "Principal: " not in info:
                raise
        else:
            info = kadmin(f"getprinc {name}")
    # A principal created by other means belongs to another machine, which
    # a computer named after it in the console must not take over.
    # Seen from here, kadmin adds "[does not exist]": this principal may not
    # read policies. The name is the first word.
    policy = re.search(r"^Policy: (\S+)", info, re.M)
    if not policy or policy.group(1) != POLICY:
        raise Refused(403, "this host is not managed by the console")

    with tempfile.TemporaryDirectory() as tmp:
        keytab = os.path.join(tmp, "krb5.keytab")
        kadmin(f"ktadd -k {keytab} {name}")
        with open(keytab, "rb") as f:
            data = f.read()

    conn.unbind_s()
    return data


class Handler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        client = self.headers.get("X-Forwarded-For", self.client_address[0])
        if self.path != "/join":
            return self.answer(404, b"not found\n")
        try:
            length = max(0, int(self.headers.get("Content-Length") or 0))
        except ValueError:
            return self.answer(400, b"bad request\n")
        if length > 4096:
            return self.answer(413, b"request too large\n")
        form = urllib.parse.parse_qs(self.rfile.read(length).decode())
        host = form.get("host", [""])[0].strip().lower()
        try:
            with JOIN_LOCK:
                keytab = join(host, form.get("password", [""])[0])
        except Refused as err:
            log.warning("join of %r from %s refused: %s", host, client, err)
            return self.answer(err.status, f"{err}\n".encode())
        except Exception:
            log.exception("join of %r from %s failed", host, client)
            return self.answer(500, b"join failed, see the server's logs\n")
        log.info("%s joined from %s", host, client)
        self.answer(200, keytab, "application/octet-stream")

    def answer(self, status, body, content_type="text/plain"):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass  # every outcome is logged above, without the noise


http.server.ThreadingHTTPServer(LISTEN, Handler).serve_forever()
