# Generated by Ansible.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 301 https://$host$request_uri;
}

# LemonLDAP::NG: the portal and the manager share the container, which tells
# them apart by Host.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ sw_portal_host }} {{ sw_manager_host }};

    ssl_certificate {{ sw_etc }}/pki/server.crt;
    ssl_certificate_key {{ sw_etc }}/pki/server.key;

    location / {
        proxy_pass http://127.0.0.1:{{ sw_llng_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }
}

# Twake Directory Manager: the console under /static/console/, its API under
# /api, the OpenID Connect routes at the root.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ sw_directory_host }};

    ssl_certificate {{ sw_etc }}/pki/server.crt;
    ssl_certificate_key {{ sw_etc }}/pki/server.key;

    location = / {
        return 302 /static/console/;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ sw_tdm_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
