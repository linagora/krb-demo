# Generated by Ansible.

# The join service: few requests per address, against password guessing.
limit_req_zone $binary_remote_addr zone=sw_join:1m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=sw_join_conn:1m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    return 301 https://$host$request_uri;
}

# LemonLDAP::NG: the portal and the manager share the container, which tells
# them apart by Host.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ sw_portal_host }} {{ sw_manager_host }};

    ssl_certificate {{ sw_etc }}/pki/server.crt;
    ssl_certificate_key {{ sw_etc }}/pki/server.key;

    location / {
        proxy_pass http://127.0.0.1:{{ sw_llng_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
    }
}

# Twake Directory Manager: the console under /static/console/, its API under
# /api, the OpenID Connect routes at the root.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ sw_directory_host }};

    ssl_certificate {{ sw_etc }}/pki/server.crt;
    ssl_certificate_key {{ sw_etc }}/pki/server.key;

    location = / {
        return 302 /static/console/;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ sw_tdm_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

# The domain controller itself: the join service.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ sw_fqdn }};

    ssl_certificate {{ sw_etc }}/pki/server.crt;
    ssl_certificate_key {{ sw_etc }}/pki/server.key;

    location = /join {
        limit_req zone=sw_join burst=5 nodelay;
        limit_conn sw_join_conn 2;
        limit_except POST { deny all; }
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:{{ sw_join_port }};
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        return 404;
    }
}
